# Copy this file to .env.local for development, and add the same
# variables in your Vercel project settings for production.

# --- MongoDB Atlas ---
# Connection string from your MongoDB Atlas cluster.
# Use a direct-connect Atlas URI such as:
# mongodb://<username>:<password>@<host>:27017/<database>?directConnection=true&tls=true&authSource=admin
MONGODB_URI=
MONGODB_DB_NAME=chem_neeraj_sir

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
RESEND_FROM_EMAIL=notifications@yourdomain.com
# Where contact form + waiting list notifications are sent.
ADMIN_NOTIFICATION_EMAIL=neeraj@yourdomain.com

# --- Site ---
# The live production domain, used for canonical URLs, sitemap.xml,
# robots.txt, Open Graph/Twitter cards, and JSON-LD structured data.
NEXT_PUBLIC_SITE_URL=https://www.easychembyneerajsir.in
NEXT_PUBLIC_CONTACT_EMAIL=hello@easychembyneerajsir.in
NEXT_PUBLIC_CONTACT_PHONE=+91-98765-43210
NEXT_PUBLIC_CONTACT_WHATSAPP=https://wa.me/919876543210
NEXT_PUBLIC_CONTACT_INSTAGRAM=https://www.instagram.com/
NEXT_PUBLIC_CONTACT_YOUTUBE=https://www.youtube.com/

# --- Search engine verification (optional but recommended) ---
# After adding the site in Google Search Console / Bing Webmaster Tools,
# choose the "HTML tag" verification method and paste just the content
# value here (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Sanity CMS ---
# Create a free project at sanity.io, then fill these in.
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the site runs on built-in
# fallback content so every page still works.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Needed for the admin dashboard to publish notes (Sanity writes).
# Create this in sanity.io/manage → API → Tokens, with "Editor" permissions.
SANITY_API_TOKEN=

# Makes edits made directly in Sanity Studio show up on the live site
# instantly instead of waiting for the next deploy. Generate your OWN long
# random string (e.g. `openssl rand -hex 32`) — never reuse an example
# value from this file — then configure a webhook in sanity.io/manage →
# API → Webhooks pointing at https://yourdomain.com/api/revalidate with
# this same secret — see the comment atop app/api/revalidate/route.ts.
SANITY_REVALIDATE_SECRET=

# --- Cloudinary (notes PDFs, blog images, thumbnails) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Better Auth (admin login) ---
# Generate a long random string, e.g. `openssl rand -base64 32`.
# After setting this + MONGODB_URI, create the one admin account with:
#   npm run create-admin -- "Neeraj Sharma" you@example.com "choose-a-long-unique-password"
# Use a real password manager to generate it — 12+ characters, not a word
# or pattern found in a dictionary. Never commit real credentials to git.
BETTER_AUTH_SECRET=

# --- Razorpay (architecture is ready; not wired into the site yet) ---
# The Notes purchase flow stays WhatsApp + manual UPI until you decide to
# launch online payments. Leave these blank until then.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=